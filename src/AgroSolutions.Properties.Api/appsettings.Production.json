{
  "ConnectionStrings": {
    "DefaultConnection": "Host=postgres;Port=5432;Database=agrosolutions_properties;Username=${POSTGRES_USER};Password=${POSTGRES_PASSWORD}"
  },
  "Jwt": {
    "Authority": "http://keycloak:8080/realms/agrosolutions",
    "Audience": "agrosolutions-api"
  },
  "AWS": {
    "Region": "${AWS_REGION}",
    "SQS": {
      "Queues": {
        "StatusChangedQueue": "${AWS_SQS_STATUS_CHANGED_QUEUE}",
        "ProdutorSyncQueue": "${AWS_SQS_PRODUTOR_SYNC_QUEUE}"
      }
    },
    "SNS": {
      "Topics": {
        "PropertiesEventsTopic": "${AWS_SNS_PROPERTIES_EVENTS_TOPIC}"
      }
    }
  }
}
