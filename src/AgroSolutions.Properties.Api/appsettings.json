{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=agrosolutions_properties;Username=postgres;Password=postgres"
  },
  "Jwt": {
    "Authority": "http://localhost:8080/realms/agrosolutions",
    "Audience": "agrosolutions-api"
  },
  "AWS": {
    "Region": "sa-east-1",
    "SQS": {
      "Queues": {
        "StatusChangedQueue": "agrosolutions-status-changed-queue",
        "ProdutorSyncQueue": "agrosolutions-produtor-sync-queue"
      }
    },
    "SNS": {
      "Topics": {
        "PropertiesEventsTopic": "arn:aws:sns:sa-east-1:405114419969:agrosolutions-property-events"
      }
    }
  },
  "Serilog": {
    "Using": ["Serilog.Sinks.Console", "Serilog.Sinks.File"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      },
      {
        "Name": "File",
        "Args": {
          "path": "logs/properties-service-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "outputTemplate": "[{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz}] [{Level:u3}] {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "RateLimiting": {
    "EnableRateLimiting": true,
    "DefaultLimit": 100,
    "DefaultPeriodInSeconds": 60,
    "PublicLimit": 50,
    "PublicPeriodInSeconds": 60,
    "AuthenticatedLimit": 200,
    "AuthenticatedPeriodInSeconds": 60
  }
}
